# Dev artifacts — documented in README under "Security & deployment hygiene"
test/
.bug-review/
node_modules/

# Windows installers / portable builds.
# These are hosted as GitHub Release assets (not committed to the repo).
# Vercel doesn't fetch Git LFS files at deploy time, so committing the
# EXE either way would result in a 134-byte LFS pointer being served.
*.exe

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local environment overrides
.env
.env.local
.env.*.local

.vercel
.env*
